# Copie este arquivo para .env.local (no seu computador) ou configure estas
# variáveis no painel da hospedagem.

# Endereço público do site, sem barra no final. Usado nos links de
# compartilhamento, no sitemap e nos dados para o Google.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# ID do Pixel da Meta (só números). Vazio = Pixel desligado.
NEXT_PUBLIC_META_PIXEL_ID=
